]},{"wn":706,"T":64,"status":"verificado","ambiguous":false,"ocrPrimary":[706,64]},{"wn":657,"T":56,"status":"verificado","ambiguous":true,"alternatives":["657 56","667 56"],"ocrPrimary":[657,56]},{"wn":625,"T":60,"status":"verificado","ambiguous":true,"alternatives":["625 60","625 69","626 60","626 69"],"ocrPrimary":[626,60]},{"wn":512,"T":60,"status":"verificado","ambiguous":true,"alternatives":["512 60","512 69","612 60","612 69"],"ocrPrimary":[512,60]}],"acquisitionDate":"2026-10-17","assignments":[{"id":"nh-amide-3356","observed":3356,"observedY":12,"rangeMin":3100,"rangeMax":3500,"bond":"N–H (amida)","group":"Amida primaria o secundaria","vibration":"tensión N–H","intensity":"fuerte","shape":"muy ancha","explanation":"Las amidas primarias muestran dos bandas (≈3350 y ≈3180 cm⁻¹ en sólido); las secundarias, una (≈3300 cm⁻¹). Los puentes de hidrógeno las desplazan hacia valores bajos. En pastillas de KBr, el agua absorbida puede contribuir cerca de 3400 cm⁻¹.","support":["N–H (amida) a 3179 cm⁻¹","C=O (amida I) a 1641 cm⁻¹","N–H (flexión) a 1641 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"nh-amide"},{"id":"nh-amide-3179","observed":3179,"observedY":27,"rangeMin":3100,"rangeMax":3500,"bond":"N–H (amida)","group":"Amida primaria o secundaria","vibration":"tensión N–H","intensity":"fuerte","shape":"media","explanation":"Las amidas primarias muestran dos bandas (≈3350 y ≈3180 cm⁻¹ en sólido); las secundarias, una (≈3300 cm⁻¹). Los puentes de hidrógeno las desplazan hacia valores bajos. En pastillas de KBr, el agua absorbida puede contribuir cerca de 3400 cm⁻¹.","support":["N–H (amida) a 3356 cm⁻¹","C=O (amida I) a 1641 cm⁻¹","N–H (flexión) a 1641 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"nh-amide"},{"id":"ch-sp3-2972","observed":2972,"observedY":26,"rangeMin":2840,"rangeMax":3000,"bond":"C–H sp³","group":"Grupos alquilo (CH₃, CH₂, CH)","vibration":"tensión C–H asimétrica y simétrica","intensity":"fuerte","shape":"aguda","explanation":"Bandas por debajo de 3000 cm⁻¹: CH₃ ≈2960 y ≈2870, CH₂ ≈2925 y ≈2850 cm⁻¹. Presentes en casi todas las moléculas orgánicas, por lo que por sí solas identifican poco.","support":["C–H (flexión CH₂/CH₃) a 1430 cm⁻¹","C–H (flexión CH₃ simétrica) a 1360 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch-sp3"},{"id":"co-amide-1641","observed":1641,"observedY":5.1,"rangeMin":1630,"rangeMax":1700,"bond":"C=O (amida I)","group":"Amida","vibration":"tensión C=O (banda amida I)","intensity":"fuerte","shape":"ancha","explanation":"La resonancia del par libre del nitrógeno con el carbonilo reduce el orden de enlace C=O: las amidas absorben por debajo de cetonas y ésteres. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente.","support":["N–H (amida) a 3356 cm⁻¹","N–H (amida) a 3179 cm⁻¹","N–H (flexión) a 1641 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"co-amide"},{"id":"nh-bend-1641","observed":1641,"observedY":5.1,"rangeMin":1580,"rangeMax":1650,"bond":"N–H (flexión)","group":"Amida primaria (banda amida II) o amina primaria","vibration":"flexión N–H (tijera)","intensity":"fuerte","shape":"ancha","explanation":"En amidas primarias aparece cerca de la banda C=O (amida I) y puede solaparse con ella. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente. Este pico también se usa en otra asignación: puede haber solapamiento de bandas.","support":["N–H (amida) a 3356 cm⁻¹","N–H (amida) a 3179 cm⁻¹","C=O (amida I) a 1641 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2","level":"propuesta","refId":"nh-bend"},{"id":"ch2-bend-1430","observed":1430,"observedY":34,"rangeMin":1440,"rangeMax":1475,"bond":"C–H (flexión CH₂/CH₃)","group":"Grupos alquilo","vibration":"flexión CH₂ (tijera) y CH₃ asimétrica","intensity":"media","shape":"aguda","explanation":"Señal habitual en cualquier cadena alquílica. El valor observado queda ligeramente fuera del intervalo orientativo (1440–1475 cm⁻¹).","support":["C–H sp³ a 2972 cm⁻¹","C–H (flexión CH₃ simétrica) a 1360 cm⁻¹"],"confidence":"baja","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch2-bend"},{"id":"ch3-umb-1360","observed":1360,"observedY":59,"rangeMin":1365,"rangeMax":1390,"bond":"C–H (flexión CH₃ simétrica)","group":"Grupo metilo","vibration":"flexión CH₃ simétrica («paraguas»)","intensity":"media","shape":"aguda","explanation":"Un desdoblamiento (≈1385 y ≈1365 cm⁻¹) sugiere grupos isopropilo o gem-dimetilo; el terc-butilo da ≈1395 y ≈1365 cm⁻¹. El valor observado queda ligeramente fuera del intervalo orientativo (1365–1390 cm⁻¹).","support":["C–H sp³ a 2972 cm⁻¹","C–H (flexión CH₂/CH₃) a 1430 cm⁻¹"],"confidence":"baja","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch3-umb"}],"notes":["Nombre en el Word: «Isobutyramide» (sección «6 Amides»). Nombre impreso en la imagen: «ISOBUTYRAMIDE»."],"limitations":["La curva interactiva se obtuvo digitalizando la imagen original (≈1 punto por píxel); su resolución es de ≈7–8 cm⁻¹ por encima de 2000 cm⁻¹ y ≈4 cm⁻¹ por debajo, y la transmitancia tiene una incertidumbre de ≈1 %T. No sustituye a un archivo numérico original.","Los números de onda de la tabla son los impresos por SDBS, leídos por OCR: 27 confirmados por un mínimo de la curva, 0 coherentes con ella y 1 dudosos (marcados en la tabla).","Pastilla de KBr: el agua absorbida por el KBr puede aportar señal cerca de 3400 y 1640 cm⁻¹. En el sólido los puentes de hidrógeno desplazan y ensanchan las bandas O–H y N–H.","Las asignaciones son propuestas basadas en la estructura conocida y en intervalos orientativos; no constituyen una identificación independiente del compuesto."],"distinctive":["Bandas diagnósticas: N–H (amida) 3356 cm⁻¹, N–H (amida) 3179 cm⁻¹.","El C=O aparece a menor número de onda que en cetonas (≈1690–1630 cm⁻¹); el número de bandas N–H distingue amidas primarias (dos), secundarias (una) y terciarias (ninguna)."],"howToRead":["Compruebe los ejes: número de onda (cm⁻¹) decreciente de izquierda a derecha y transmitancia en %; las absorciones son descensos de la curva.","Región de 4000 a 2500 cm⁻¹ (enlaces con H): N–H (amida) ≈3356 cm⁻¹; N–H (amida) ≈3179 cm⁻¹; C–H sp³ ≈2972 cm⁻¹. Fíjese en si hay bandas por encima de 3000 cm⁻¹ (C–H sp²/O–H/N–H) o sólo por debajo (C–H sp³).","Región de 2500 a 1500 cm⁻¹ (triples y dobles enlaces): C=O (amida I) ≈1641 cm⁻¹; N–H (flexión) ≈1641 cm⁻¹.","Región por debajo de 1500 cm⁻¹ (huella dactilar): C–H (flexión CH₂/CH₃) ≈1430 cm⁻¹; C–H (flexión CH₃ simétrica) ≈1360 cm⁻¹. Estas asignaciones son orientativas: en esta región se acoplan muchas vibraciones.","Conclusión para Isobutiramida: El C=O aparece a menor número de onda que en cetonas (≈1690–1630 cm⁻¹); el número de bandas N–H distingue amidas primarias (dos), secundarias (una) y terciarias (ninguna)."],"provenance":{"document":{"file":"ESPECTROS.docx","sha256":"1f4bf49fa4f5daada78481ea20921ee66da661441f44f81096d15a5dcfb78eec"},"docEntry":116,"docSection":"6 Amides","docName":"Isobutyramide","imageInDocx":"media/image120.png","imageSha256":"65885978c60362510d81058f1e0c93d5ebac33f5951603d7a47ebdcf2a642b73","imagePrintedName":"ISOBUTYRAMIDE","techniquePrinted":"KBR DISC","nameCheck":"coincide","axisCalibration":{"frame":{"left":29,"right":714,"top":96,"bottom":417,"imageW":715,"imageH":553},"ticksFound":{"500":true,"1000":true,"1500":true,"2000":true,"3000":true},"model":"SDBS a tramos: 4000-2000 cm-1 y 2000-400 cm-1 (la segunda región con el doble de píxeles por cm-1); 100 %T arriba, 0 %T abajo"},"peakValidation":"pico OCR aceptado como verificado si existe un mínimo local de la curva digitalizada a ±2,5 px y ±5 %T","peakStats":{"verificado":27,"dudoso":1},"detectedPeaksOnCurve":[{"x":3350.9,"y":12.2,"widthCm":256,"prominence":77.3},{"x":3172.6,"y":29,"widthCm":59,"prominence":20.9},{"x":2963.8,"y":28,"widthCm":17,"prominence":57.6},{"x":2925.8,"y":64.8,"widthCm":13,"prominence":14},{"x":2903.1,"y":77.6,"widthCm":6,"prominence":3.1},{"x":2865.1,"y":77.6,"widthCm":15,"prominence":5.6},{"x":2808.2,"y":83.5,"widthCm":23,"prominence":4.4},{"x":1641.2,"y":5.1,"widthCm":74,"prominence":88.9},{"x":1468.5,"y":38.6,"widthCm":8,"prominence":34.9},{"x":1453.3,"y":62,"widthCm":4,"prominence":9},{"x":1426.7,"y":35.5,"widthCm":18,"prominence":45.8},{"x":1371.7,"y":63.9,"widthCm":4,"prominence":11.5},{"x":1356.5,"y":61.4,"widthCm":4,"prominence":15.1},{"x":1293.9,"y":26.8,"widthCm":11,"prominence":57},{"x":1168.6,"y":77.6,"widthCm":5,"promi