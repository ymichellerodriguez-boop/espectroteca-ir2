459 62","1466 52","1466 62"],"ocrPrimary":[1466,62]},{"wn":1390,"T":56,"status":"coherente","ambiguous":true,"alternatives":["1390 55","1390 56","1390 58","1390 65","1390 66","1390 68"],"ocrPrimary":[1390,56]},{"wn":1668,"T":16,"status":"sin-curva","ambiguous":true,"alternatives":["1668 15","1668 16"],"ocrPrimary":[1668,16],"orderWarning":true},{"wn":1330,"T":66,"status":"coherente","ambiguous":true,"alternatives":["1330 65","1330 66"],"ocrPrimary":[1330,66]},{"wn":1236,"T":60,"status":"verificado","ambiguous":true,"alternatives":["1236 60","1236 69","1238 60","1238 69","1239 60","1239 69"],"ocrPrimary":[1238,60]},{"wn":1208,"T":17,"status":"verificado","ambiguous":true,"alternatives":["1200 17","1208 17","1260 17","1268 17"],"ocrPrimary":[1208,17]},{"wn":1142,"T":26,"status":"verificado","ambiguous":true,"alternatives":["1142 25","1142 26"],"ocrPrimary":[1142,25]},{"wn":1016,"T":74,"status":"verificado","ambiguous":false,"ocrPrimary":[1016,74]},{"wn":913,"T":12,"status":"verificado","ambiguous":false,"ocrPrimary":[913,12]},{"wn":469,"T":72,"status":"verificado","ambiguous":true,"alternatives":["469 72","489 72"],"ocrPrimary":[469,72]}],"acquisitionDate":"2026-10-17","assignments":[{"id":"oh-free-3617","observed":3617,"observedY":39,"rangeMin":3580,"rangeMax":3650,"bond":"O–H libre","group":"Alcohol o fenol (O–H no asociado)","vibration":"tensión O–H","intensity":"media","shape":"aguda","explanation":"Sólo aparece cuando las moléculas no forman puentes de hidrógeno: disoluciones diluidas (p. ej. en CCl₄) o fase gas. En disolución diluida en CCl₄ se observa la O–H libre, aguda, además de la asociada si la concentración lo permite.","support":["O–H asociado a 3371 cm⁻¹","C–O a 1208 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"oh-free"},{"id":"oh-hb-3371","observed":3371,"observedY":66,"rangeMin":3200,"rangeMax":3550,"bond":"O–H asociado","group":"Alcohol o fenol (O–H con puentes de hidrógeno)","vibration":"tensión O–H","intensity":"media","shape":"ancha","explanation":"Los puentes de hidrógeno debilitan el enlace O–H y generan una distribución de entornos: la banda se desplaza a menor número de onda y se ensancha.","support":["O–H libre a 3617 cm⁻¹","C–O a 1208 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"oh-hb"},{"id":"ch-sp3-2975","observed":2975,"observedY":4,"rangeMin":2840,"rangeMax":3000,"bond":"C–H sp³","group":"Grupos alquilo (CH₃, CH₂, CH)","vibration":"tensión C–H asimétrica y simétrica","intensity":"fuerte","shape":"media","explanation":"Bandas por debajo de 3000 cm⁻¹: CH₃ ≈2960 y ≈2870, CH₂ ≈2925 y ≈2850 cm⁻¹. Presentes en casi todas las moléculas orgánicas, por lo que por sí solas identifican poco.","support":["C–H (flexión CH₂/CH₃) a 1466 cm⁻¹","C–H (flexión CH₃ simétrica) a 1365 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch-sp3"},{"id":"ch2-bend-1466","observed":1466,"observedY":52,"rangeMin":1440,"rangeMax":1475,"bond":"C–H (flexión CH₂/CH₃)","group":"Grupos alquilo","vibration":"flexión CH₂ (tijera) y CH₃ asimétrica","intensity":"media","shape":"aguda","explanation":"Señal habitual en cualquier cadena alquílica.","support":["C–H sp³ a 2975 cm⁻¹","C–H (flexión CH₃ simétrica) a 1365 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch2-bend"},{"id":"ch3-umb-1365","observed":1365,"observedY":13.5,"rangeMin":1365,"rangeMax":1390,"bond":"C–H (flexión CH₃ simétrica)","group":"Grupo metilo","vibration":"flexión CH₃ simétrica («paraguas»)","intensity":"fuerte","shape":"media","explanation":"Un desdoblamiento (≈1385 y ≈1365 cm⁻¹) sugiere grupos isopropilo o gem-dimetilo; el terc-butilo da ≈1395 y ≈1365 cm⁻¹. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente.","support":["C–H sp³ a 2975 cm⁻¹","C–H (flexión CH₂/CH₃) a 1466 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch3-umb"},{"id":"co-alcohol-1208","observed":1208,"observedY":17,"rangeMin":1000,"rangeMax":1260,"bond":"C–O","group":"Alcohol","vibration":"tensión C–O","intensity":"fuerte","shape":"media","explanation":"Orientativo: primario ≈1050, secundario ≈1100, terciario ≈1150 cm⁻¹. El acoplamiento con C–C hace que estas posiciones sean aproximadas.","support":["O–H libre a 3617 cm⁻¹","O–H asociado a 3371 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"co-alcohol"}],"notes":["Nombre en el Word: «2-metil-2-propanol» (sección «1. Alcohols»). Nombre impreso en la imagen: «2-METHYL-2-PROPANOL»."],"limitations":["La curva interactiva se obtuvo digitalizando la imagen original (≈1 punto por píxel); su resolución es de ≈7–8 cm⁻¹ por encima de 2000 cm⁻¹ y ≈4 cm⁻¹ por debajo, y la transmitancia tiene una incertidumbre de ≈1 %T. No sustituye a un archivo numérico original.","Los números de onda de la tabla son los impresos por SDBS, leídos por OCR: 12 confirmados por un mínimo de la curva, 3 coherentes con ella y 1 dudosos (marcados en la tabla).","Disolución en CCl₄: el disolvente absorbe con fuerza en algunas regiones (p. ej. ≈1600–1500 y por debajo de ≈850 cm⁻¹); SDBS recorta esas zonas, que aparecen como huecos en la curva.","Las asignaciones son propuestas basadas en la estructura conocida y en intervalos orientativos; no constituyen una identificación independiente del compuesto."],"distinctive":["Bandas diagnósticas: O–H libre 3617 cm⁻¹, C–O 1208 cm⁻¹.","Busque primero la O–H ancha sobre 3300 cm⁻¹ y confírmela con una C–O intensa entre 1260 y 1000 cm⁻¹; la ausencia de C=O descarta ácidos y ésteres."],"howToRead":["Compruebe los ejes: número de onda (cm⁻¹) decreciente de izquierda a derecha y transmitancia en %; las absorciones son descensos de la curva.","Región de 4000 a 2500 cm⁻¹ (enlaces con H): O–H libre ≈3617 cm⁻¹; O–H asociado ≈3371 cm⁻¹; C–H sp³ ≈2975 cm⁻¹. Fíjese en si hay bandas por encima de 3000 cm⁻¹ (C–H sp²/O–H/N–H) o sólo por debajo (C–H sp³).","Región de 2500 a 1500 cm⁻¹: no aparece ninguna banda C=O, C≡N o C≡C con suficiente evidencia, lo que también es informativo.","Región por debajo de 1500 cm⁻¹ (huella dactilar): C–H (flexión CH₂/CH₃) ≈1466 cm⁻¹; C–H (flexión CH₃ simétrica) ≈1365 cm⁻¹; C–O ≈1208 cm⁻¹. Estas asignaciones son orientativas: en esta región se acoplan muchas vibraciones.","Conclusión para 2-Metil-2-propanol: Busque primero la O–H ancha sobre 3300 cm⁻¹ y confírmela con una C–O intensa entre 1260 y 1000 cm⁻¹; la ausencia de C=O descarta ácidos y ésteres."],"provenance":{"document":{"file":"ESPECTROS.docx","sha256":"1f4bf49fa4f5daada78481ea20921ee66da661441f44f81096d15a5dcfb78eec"},"docEntry":7,"docSection":"1. Alcohols","docName":"2-metil-2-p