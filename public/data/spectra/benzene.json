15,70]},{"wn":1526,"T":81,"status":"verificado","ambiguous":false,"ocrPrimary":[1526,81]},{"wn":1479,"T":20,"status":"verificado","ambiguous":false,"ocrPrimary":[1479,20]},{"wn":1393,"T":84,"status":"verificado","ambiguous":false,"ocrPrimary":[1393,84]},{"wn":1176,"T":86,"status":"verificado","ambiguous":false,"ocrPrimary":[1176,86]},{"wn":1038,"T":49,"status":"verificado","ambiguous":false,"ocrPrimary":[1038,49]},{"wn":674,"T":4,"status":"verificado","ambiguous":false,"ocrPrimary":[674,4]}],"acquisitionDate":"2026-10-17","assignments":[{"id":"ch-sp2-arom-3036","observed":3036,"observedY":27,"rangeMin":3000,"rangeMax":3100,"bond":"C–H sp² (aromático)","group":"Anillo aromático","vibration":"tensión =C–H","intensity":"fuerte","shape":"media","explanation":"Las bandas por encima de 3000 cm⁻¹ indican C–H unidos a carbonos sp² (aromáticos o alquénicos).","support":["C=C aromático a 1479 cm⁻¹","C–H aromático (fuera del plano) a 674 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch-sp2-arom"},{"id":"arom-ring2-1479","observed":1479,"observedY":20,"rangeMin":1450,"rangeMax":1525,"bond":"C=C aromático","group":"Anillo aromático","vibration":"tensión del anillo (C=C)","intensity":"fuerte","shape":"aguda","explanation":"Segundo par de bandas del anillo (≈1500 y ≈1450 cm⁻¹); la de ≈1450 se solapa con la flexión de CH₂.","support":["C–H sp² (aromático) a 3036 cm⁻¹","C–H aromático (fuera del plano) a 674 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"arom-ring2"},{"id":"arom-oop-674","observed":674,"observedY":4,"rangeMin":675,"rangeMax":900,"bond":"C–H aromático (fuera del plano)","group":"Anillo aromático (sustitución)","vibration":"flexión C–H fuera del plano","intensity":"fuerte","shape":"media","explanation":"Monosustituido ≈770–730 y ≈710–690; orto ≈770–735; meta ≈810–750 y ≈725–680; para ≈860–800 cm⁻¹ (orientativo). El valor observado queda ligeramente fuera del intervalo orientativo (675–900 cm⁻¹).","support":["C–H sp² (aromático) a 3036 cm⁻¹","C=C aromático a 1479 cm⁻¹"],"confidence":"baja","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"arom-oop"}],"notes":["Nombre en el Word: «Benzene» (sección «7 Aromatics»). Nombre impreso en la imagen: «BENZENE»."],"limitations":["La curva interactiva se obtuvo digitalizando la imagen original (≈1 punto por píxel); su resolución es de ≈7–8 cm⁻¹ por encima de 2000 cm⁻¹ y ≈4 cm⁻¹ por debajo, y la transmitancia tiene una incertidumbre de ≈1 %T. No sustituye a un archivo numérico original.","Los números de onda de la tabla son los impresos por SDBS, leídos por OCR: 11 confirmados por un mínimo de la curva, 0 coherentes con ella y 0 dudosos (marcados en la tabla).","Película de líquido puro: las moléculas interaccionan entre sí (puentes de hidrógeno), por lo que las bandas O–H/N–H aparecen asociadas y anchas.","Las asignaciones son propuestas basadas en la estructura conocida y en intervalos orientativos; no constituyen una identificación independiente del compuesto."],"distinctive":["Bandas diagnósticas: C–H sp² (aromático) 3036 cm⁻¹.","C–H por encima de 3000 cm⁻¹, bandas del anillo ≈1600 y ≈1500 cm⁻¹ y flexiones fuera del plano intensas por debajo de 900 cm⁻¹."],"howToRead":["Compruebe los ejes: número de onda (cm⁻¹) decreciente de izquierda a derecha y transmitancia en %; las absorciones son descensos de la curva.","Región de 4000 a 2500 cm⁻¹ (enlaces con H): C–H sp² (aromático) ≈3036 cm⁻¹. Fíjese en si hay bandas por encima de 3000 cm⁻¹ (C–H sp²/O–H/N–H) o sólo por debajo (C–H sp³).","Región de 2500 a 1500 cm⁻¹: no aparece ninguna banda C=O, C≡N o C≡C con suficiente evidencia, lo que también es informativo.","Región por debajo de 1500 cm⁻¹ (huella dactilar): C=C aromático ≈1479 cm⁻¹; C–H aromático (fuera del plano) ≈674 cm⁻¹. Estas asignaciones son orientativas: en esta región se acoplan muchas vibraciones.","Ausencias significativas: C=C aromático (1575–1620 cm⁻¹) — No se encontró una banda en 1575–1620 cm⁻¹ en la tabla de picos.","Conclusión para Benceno: C–H por encima de 3000 cm⁻¹, bandas del anillo ≈1600 y ≈1500 cm⁻¹ y flexiones fuera del plano intensas por debajo de 900 cm⁻¹."],"provenance":{"document":{"file":"ESPECTROS.docx","sha256":"1f4bf49fa4f5daada78481ea20921ee66da661441f44f81096d15a5dcfb78eec"},"docEntry":118,"docSection":"7 Aromatics","docName":"Benzene","imageInDocx":"media/image109.gif","imageSha256":"4ccbc269bbf9d74a3d15afdd066edc758064be51d2b568a55310e20563f6bae6","imagePrintedName":"BENZENE","techniquePrinted":"LIQUID FILM","nameCheck":"coincide","axisCalibration":{"frame":{"left":29,"right":714,"top":96,"bottom":417,"imageW":715,"imageH":553},"ticksFound":{"500":true,"1000":true,"1500":true,"2000":true,"3000":true},"model":"SDBS a tramos: 4000-2000 cm-1 y 2000-400 cm-1 (la segunda región con el doble de píxeles por cm-1); 100 %T arriba, 0 %T abajo"},"peakValidation":"pico OCR aceptado como verificado si existe un mínimo local de la curva digitalizada a ±2,5 px y ±5 %T","peakStats":{"verificado":11},"detectedPeaksOnCurve":[{"x":3085.3,"y":43.3,"widthCm":8,"prominence":35.5},{"x":3066.3,"y":51.1,"widthCm":7,"prominence":22.7},{"x":3032.1,"y":28.7,"widthCm":21,"prominence":66},{"x":2880.3,"y":90.3,"widthCm":5,"prominence":3.1},{"x":2204.7,"y":92.2,"widthCm":9,"prominence":2.5},{"x":1958.1,"y":78.8,"widthCm":16,"prominence":15.6},{"x":1812,