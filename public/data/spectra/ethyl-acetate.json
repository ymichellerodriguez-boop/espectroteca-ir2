dactilar): C–H (flexión CH₂/CH₃) ≈1448 cm⁻¹; C–H (flexión CH₃ simétrica) ≈1374 cm⁻¹; C(=O)–O ≈1243 cm⁻¹; O–C(alquilo) ≈1048 cm⁻¹. Estas asignaciones son orientativas: en esta región se acoplan muchas vibraciones.","Conclusión para Acetato de etilo: Patrón de «tres bandas»: C=O ≈1740 cm⁻¹ y dos C–O fuertes entre 1300 y 1000 cm⁻¹."],"provenance":{"document":{"file":"ESPECTROS.docx","sha256":"1f4bf49fa4f5daada78481ea20921ee66da661441f44f81096d15a5dcfb78eec"},"docEntry":83,"docSection":"5 Esters","docName":"Ethyl acetate","imageInDocx":"media/image24.png","imageSha256":"8786c6d3ae3d0f5c12f0a49e680956fd61073f3289fa566845a1a4b65f8e24a9","imagePrintedName":"ETHYL ACETATE","techniquePrinted":"LIQUID FILM","nameCheck":"coincide","axisCalibration":{"frame":{"left":29,"right":714,"top":96,"bottom":417,"imageW":715,"imageH":553},"ticksFound":{"500":true,"1000":true,"1500":true,"2000":true,"3000":true},"model":"SDBS a tramos: 4000-2000 cm-1 y 2000-400 cm-1 (la segunda región con el doble de píxeles por cm-1); 100 %T arriba, 0 %T abajo"},"peakValidation":"pico OCR aceptado como verificado si existe un mínimo local de la curva digitalizada a ±2,5 px y ±5 %T","peakStats":{"verificado":20,"coherente":5,"dudoso":1},"detectedPeaksOnCurve":[{"x":3453.4,"y":85.4,"widthCm":39,"prominence":7.2},{"x":2979,"y":34.6,"widthCm":71,"prominence":59.5},{"x":2933.4,"y":57.9,"widthCm":14,"prominence":5.3},{"x":2903.1,"y":64.8,"widthCm":9,"prominence":6.5},{"x":2872.7,"y":77,"widthCm":6,"prominence":1.9},{"x":2079.4,"y":90.8,"widthCm":32,"prominence":3.6},{"x":1887.9,"y":88.8,"widthCm":24,"prominence":2.8},{"x":1741.8,"y":5,"widthCm":49,"prominence":89.7},{"x":1462.8,"y":57.3,"widthCm":7,"prominence":2.8},{"x":1443.8,"y":53,"widthCm":38,"prominence":17.4},{"x":1371.7,"y":14.3,"widthCm":27,"prominence":69.3},{"x":1358.4,"y":45.5,"widthCm":3,"prominence":1.9},{"x":1297.7,"y":53.6,"widthCm":8,"prominence":5.3},{"x":1242.6,"y":5.9,"widthCm":71,"prominence":86},{"x":1094.6,"y":56.1,"widthCm":12,"prominen