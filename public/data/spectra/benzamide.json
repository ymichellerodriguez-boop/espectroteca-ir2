0","616 79"],"ocrPrimary":[616,70]},{"wn":532,"T":70,"status":"verificado","ambiguous":true,"alternatives":["532 70","632 70"],"ocrPrimary":[632,70]}],"acquisitionDate":"2026-10-17","assignments":[{"id":"nh-amide-3369","observed":3369,"observedY":10,"rangeMin":3100,"rangeMax":3500,"bond":"N–H (amida)","group":"Amida primaria o secundaria","vibration":"tensión N–H","intensity":"fuerte","shape":"media","explanation":"Las amidas primarias muestran dos bandas (≈3350 y ≈3180 cm⁻¹ en sólido); las secundarias, una (≈3300 cm⁻¹). Los puentes de hidrógeno las desplazan hacia valores bajos. En pastillas de KBr, el agua absorbida puede contribuir cerca de 3400 cm⁻¹.","support":["N–H (amida) a 3177 cm⁻¹","C=O (amida I) a 1658 cm⁻¹","N–H (flexión) a 1658 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"nh-amide"},{"id":"nh-amide-3177","observed":3177,"observedY":29,"rangeMin":3100,"rangeMax":3500,"bond":"N–H (amida)","group":"Amida primaria o secundaria","vibration":"tensión N–H","intensity":"fuerte","shape":"media","explanation":"Las amidas primarias muestran dos bandas (≈3350 y ≈3180 cm⁻¹ en sólido); las secundarias, una (≈3300 cm⁻¹). Los puentes de hidrógeno las desplazan hacia valores bajos. En pastillas de KBr, el agua absorbida puede contribuir cerca de 3400 cm⁻¹.","support":["N–H (amida) a 3369 cm⁻¹","C=O (amida I) a 1658 cm⁻¹","N–H (flexión) a 1658 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"nh-amide"},{"id":"ch-sp2-arom-3066","observed":3066,"observedY":70,"rangeMin":3000,"rangeMax":3100,"bond":"C–H sp² (aromático)","group":"Anillo aromático","vibration":"tensión =C–H","intensity":"media","shape":"aguda","explanation":"Las bandas por encima de 3000 cm⁻¹ indican C–H unidos a carbonos sp² (aromáticos o alquénicos).","support":["C=C aromático a 1579 cm⁻¹","C=C aromático a 1450 cm⁻¹","C–H aromático (fuera del plano) a 686 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch-sp2-arom"},{"id":"co-amide-1658","observed":1658,"observedY":5,"rangeMin":1630,"rangeMax":1700,"bond":"C=O (amida I)","group":"Amida","vibration":"tensión C=O (banda amida I)","intensity":"fuerte","shape":"media","explanation":"La resonancia del par libre del nitrógeno con el carbonilo reduce el orden de enlace C=O: las amidas absorben por debajo de cetonas y ésteres. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente.","support":["N–H (amida) a 3369 cm⁻¹","N–H (amida) a 3177 cm⁻¹","N–H (flexión) a 1658 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"co-amide"},{"id":"nh-bend-1658","observed":1658,"observedY":5,"rangeMin":1580,"rangeMax":1650,"bond":"N–H (flexión)","group":"Amida primaria (banda amida II) o amina primaria","vibration":"flexión N–H (tijera)","intensity":"fuerte","shape":"media","explanation":"En amidas primarias aparece cerca de la banda C=O (amida I) y puede solaparse con ella. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente. El valor observado queda ligeramente fuera del intervalo orientativo (1580–1650 cm⁻¹). Este pico también se usa en otra asignación: puede haber solapamiento de bandas.","support":["N–H (amida) a 3369 cm⁻¹","N–H (amida) a 3177 cm⁻¹","C=O (amida I) a 1658 cm⁻¹"],"confidence":"baja","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2","level":"propuesta","refId":"nh-bend"},{"id":"arom-ring1-1579","observed":1579,"observedY":19,"rangeMin":1575,"rangeMax":1620,"bond":"C=C aromático","group":"Anillo aromático","vibration":"tensión del anillo (C=C)","intensity":"fuerte","shape":"aguda","explanation":"Las vibraciones del esqueleto aromático dan bandas cerca de 1600 y 1580 cm⁻¹ (esta última más intensa si hay conjugación).","support":["C–H sp² (aromático) a 3066 cm⁻¹","C=C aromático a 1450 cm⁻¹","C–H aromático (fuera del plano) a 686 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"arom-ring1"},{"id":"arom-ring2-1450","observed":1450,"observedY":50,"rangeMin":1450,"rangeMax":1525,"bond":"C=C aromático","group":"Anillo aromático","vibration":"tensión del anillo (C=C)","intensity":"media","shape":"aguda","explanation":"Segundo par de bandas del anillo (≈1500 y ≈1450 cm⁻¹); la de ≈1450 se solapa con la flexión de CH₂.","support":["C–H sp² (aromático) a 3066 cm⁻¹","C=C aromático a 1579 cm⁻¹","C–H aromático (fuera del plano) a 686 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"arom-ring2"},{"id":"arom-oop-686","observed":686,"observedY":44,"rangeMin":675,"rangeMax":900,"bond":"C–H aromático (fuera del plano)","group":"Anillo aromático (sustitución)","vibration":"flexión C–H fuera del plano","intensity":"media","shape":"aguda","explanation":"Monosustituido ≈770–730 y ≈710–690; orto ≈770–735; meta ≈810–750 y ≈725–680; para ≈860–800 cm⁻¹ (orientativo).","support":["C–H sp² (aromático) a 3066 cm⁻¹","C=C aromático a 1579 cm⁻¹","C=C aromático a 1450 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"arom-oop"}],"notes":["Nombre en el Word: «Benzamide» (sección «6 Amides»). Nombre impreso en la imagen: «BENZAMIDE»."],"limitations":["La curva interactiva se obtuvo digitalizando la imagen original (≈1 punto por píxel); su resolución es de ≈7–8 cm⁻¹ por encima de 2000 cm⁻¹ y ≈4 cm⁻¹ por debajo, y la transmitancia tiene una incertidumbre de ≈1 %T. No sustituye a un archivo numérico original.","Los números de onda de la tabla son los impresos por SDBS, leídos por OCR: 26 confirmados por un mínimo de la curva, 1 coherentes con ella y 2 dudosos (marcados en la tabla).","Pastilla de KBr: el agua absorbida por el KBr puede aportar señal cerca de 3400 y 1640 cm⁻¹. En el sólido los puentes de hidrógeno desplazan y ensanchan las bandas O–H y N–H.","Las asignaciones son propuestas basadas en la estructura conocida y en intervalos orientativos; no constituyen una identificación independiente del compuesto."],"distinctive":["Bandas diagnósticas: N–H (amida) 3369 cm⁻¹, N–H (amida) 3177 cm⁻¹, C–H sp² (aromático) 3066 cm⁻¹, C=C aromático 1579 cm⁻¹.","El C=O aparece a menor número de onda que en cetonas (≈1690–1630 cm⁻¹); el número de bandas N–H distingue amidas primarias (dos), secundarias (una) y terciarias (ninguna)."],"howToRead":["Compruebe los ejes: número de onda (cm⁻¹) decreciente de izquierda a derecha y transmitancia en %; las absorciones son descensos de la curva.","Región de 4000 a 2500 cm⁻¹ (enlaces con H): N–H (amida) ≈3369 cm⁻¹; N–H (amida) ≈3177 cm⁻¹; C–H sp² (aromático) ≈3066 cm⁻¹. Fíjese en si hay bandas por encima de 3000 cm⁻¹ (C–H sp²/O–H/N–H) o sólo por debajo (C–H sp³).","Región de 2500 a 1500 cm⁻¹ (triples y dobles enlaces): C=O (amida I) ≈1658 cm⁻¹; N–H (flexión) ≈1658 cm⁻¹; C=C aromático ≈1579 cm⁻¹.","Región por debajo de 1500 cm⁻¹ (huella dactilar): C=C aromático ≈1450 cm⁻¹; C–H aromático (fuera del plano) ≈686 cm⁻¹. Estas asignaciones son orientativas: en esta región se acoplan muchas vibraciones.","Conclusión para Benzamida: El C=O aparece a menor número de onda que en cetonas (≈1690–1630 cm⁻¹); el número de bandas N–H distingue amidas primarias (dos), secundarias (una) y terciarias (ninguna)."],"provenance":{"document":{"file":"ESPECTROS.docx","sha256":"1f4bf49fa4f5daada78481ea20921ee66da661441f44f81096d15a5dcfb78eec"},"docEntry":103,"docSection":"6 Amides","docName":"Benzamide","imageInDocx":"media/image4.png","imageSha256":"a47b17ec6105ecc8ce92fa6d889c77fc55d17eb7a496478c694fb60f69efb8af","imagePrintedName":"BENZAMIDE","techniquePrinted":"KBR DISC","nameCheck":"coincide","axisCalibration":{"frame":{"left":29,"right":714,"top":96,"bottom":417,"imageW":715,"imageH":553},"ticksFound":{"500":true,"1000":true,"1500":true,"2000":true,"3000":true},"model":"SDBS a tramos: 4000-2000 cm-1 y 2000-400 cm-1 (la segunda región con el doble de píxeles por cm-1); 100 %T arriba, 0 %T abajo"},"peakValidation":"pico OCR aceptado como verificado si existe un mínimo local de la curva digitalizada a ±2,5 px y ±5 %T","peakStats":{"verificado":26,"dudoso":2,"coherente":1},"detectedPeaksOnCurve":[{"x":3362.3,"y":10.3,"widthCm":51,"prominence":81.9},{"x":3172.6,"y":30.5,"widthCm":45,"prominence":42.1},{"x":3062.5,"y":73.2,"widthCm":7,"prominence":3},{"x":3024.5,"y":81.3,"widthCm":4,"prominence":2.8},{"x":2770.2,"y":89.3,"widthCm":59,"prominence":2.5}