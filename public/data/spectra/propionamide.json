tatus":"verificado","ambiguous":true,"alternatives":["1005 72","1006 72","1008 72"],"ocrPrimary":[1006,72]},{"wn":822,"T":49,"status":"verificado","ambiguous":false,"ocrPrimary":[822,49]},{"wn":646,"T":39,"status":"verificado","ambiguous":true,"alternatives":["646 39","648 39"],"ocrPrimary":[648,39]},{"wn":481,"T":52,"status":"verificado","ambiguous":true,"alternatives":["481 52","481 62"],"ocrPrimary":[481,52]}],"acquisitionDate":"2026-10-17","assignments":[{"id":"nh-amide-3363","observed":3363,"observedY":16,"rangeMin":3100,"rangeMax":3500,"bond":"N–H (amida)","group":"Amida primaria o secundaria","vibration":"tensión N–H","intensity":"fuerte","shape":"muy ancha","explanation":"Las amidas primarias muestran dos bandas (≈3350 y ≈3180 cm⁻¹ en sólido); las secundarias, una (≈3300 cm⁻¹). Los puentes de hidrógeno las desplazan hacia valores bajos.","support":["N–H (amida) a 3192 cm⁻¹","C=O (amida I) a 1653 cm⁻¹","N–H (flexión) a 1653 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"nh-amide"},{"id":"nh-amide-3192","observed":3192,"observedY":18,"rangeMin":3100,"rangeMax":3500,"bond":"N–H (amida)","group":"Amida primaria o secundaria","vibration":"tensión N–H","intensity":"fuerte","shape":"media","explanation":"Las amidas primarias muestran dos bandas (≈3350 y ≈3180 cm⁻¹ en sólido); las secundarias, una (≈3300 cm⁻¹). Los puentes de hidrógeno las desplazan hacia valores bajos.","support":["N–H (amida) a 3363 cm⁻¹","C=O (amida I) a 1653 cm⁻¹","N–H (flexión) a 1653 cm⁻¹"],"confidence":"alta","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"nh-amide"},{"id":"ch-sp3-2924","observed":2924,"observedY":4,"rangeMin":2840,"rangeMax":3000,"bond":"C–H sp³","group":"Grupos alquilo (CH₃, CH₂, CH)","vibration":"tensión C–H asimétrica y simétrica","intensity":"fuerte","shape":"ancha","explanation":"Bandas por debajo de 3000 cm⁻¹: CH₃ ≈2960 y ≈2870, CH₂ ≈2925 y ≈2850 cm⁻¹. Presentes en casi todas las moléculas orgánicas, por lo que por sí solas identifican poco. Muestra en suspensión de Nujol: esta banda incluye la contribución del aceite mineral y no puede atribuirse sólo a la muestra.","support":["C–H (flexión CH₂/CH₃) a 1465 cm⁻¹","C–H (flexión CH₃ simétrica) a 1378 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch-sp3"},{"id":"co-amide-1653","observed":1653,"observedY":15.3,"rangeMin":1630,"rangeMax":1700,"bond":"C=O (amida I)","group":"Amida","vibration":"tensión C=O (banda amida I)","intensity":"fuerte","shape":"ancha","explanation":"La resonancia del par libre del nitrógeno con el carbonilo reduce el orden de enlace C=O: las amidas absorben por debajo de cetonas y ésteres. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente.","support":["N–H (amida) a 3363 cm⁻¹","N–H (amida) a 3192 cm⁻¹","N–H (flexión) a 1653 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"co-amide"},{"id":"nh-bend-1653","observed":1653,"observedY":15.3,"rangeMin":1580,"rangeMax":1650,"bond":"N–H (flexión)","group":"Amida primaria (banda amida II) o amina primaria","vibration":"flexión N–H (tijera)","intensity":"fuerte","shape":"ancha","explanation":"En amidas primarias aparece cerca de la banda C=O (amida I) y puede solaparse con ella. Posición estimada sobre la curva digitalizada: este máximo de absorción no figura en la tabla de picos de la fuente. El valor observado queda ligeramente fuera del intervalo orientativo (1580–1650 cm⁻¹). Este pico también se usa en otra asignación: puede haber solapamiento de bandas.","support":["N–H (amida) a 3363 cm⁻¹","N–H (amida) a 3192 cm⁻¹","C=O (amida I) a 1653 cm⁻¹"],"confidence":"baja","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2","level":"propuesta","refId":"nh-bend"},{"id":"ch2-bend-1465","observed":1465,"observedY":12,"rangeMin":1440,"rangeMax":1475,"bond":"C–H (flexión CH₂/CH₃)","group":"Grupos alquilo","vibration":"flexión CH₂ (tijera) y CH₃ asimétrica","intensity":"fuerte","shape":"ancha","explanation":"Señal habitual en cualquier cadena alquílica. Muestra en suspensión de Nujol: esta banda incluye la contribución del aceite mineral y no puede atribuirse sólo a la muestra.","support":["C–H sp³ a 2924 cm⁻¹","C–H (flexión CH₃ simétrica) a 1378 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch2-bend"},{"id":"ch3-umb-1378","observed":1378,"observedY":20,"rangeMin":1365,"rangeMax":1390,"bond":"C–H (flexión CH₃ simétrica)","group":"Grupo metilo","vibration":"flexión CH₃ simétrica («paraguas»)","intensity":"fuerte","shape":"aguda","explanation":"Un desdoblamiento (≈1385 y ≈1365 cm⁻¹) sugiere grupos isopropilo o gem-dimetilo; el terc-butilo da ≈1395 y ≈1365 cm⁻¹. Muestra en suspensión de Nujol: esta banda incluye la contribución del aceite mineral y no puede atribuirse sólo a la muestra.","support":["C–H sp³ a 2924 cm⁻¹","C–H (flexión CH₂/CH₃) a 1465 cm⁻¹"],"confidence":"media","source":"[SWK] Silverstein, Webster, Kiemle y Bryce, Spectrometric Identification of Organic Compounds, 8.ª ed. (Wiley, 2014), cap. 2; [PLKV] Pavia, Lampman, Kriz y Vyvyan, Introduction to Spectroscopy, 5.ª ed. (Cengage, 2015), cap. 2","level":"propuesta","refId":"ch3-umb"}],"notes":["Nombre en el Word: «Propionamide» (sección «6 Amides»). Nombre impreso en la imagen: «PROPIONAMIDE»."],"limitations":["La curva interactiva se obtuvo digitalizando la imagen original (≈1 punto por píxel); su resolución es de ≈7–8 cm⁻¹ por encima de 2000 cm⁻¹ y ≈4 cm⁻¹ por debajo, y la transmitancia tiene una incertidumbre de ≈1 %T. No sustituye a un archivo numérico original.","Los números de onda de la tabla son los impresos por SDBS, leídos por OCR: 16 confirmados por un mínimo de la curva, 2 coherentes con ella y 1 dudosos (marcados en la tabla).","Suspensión en Nujol: las bandas ≈2950–2850, ≈1460 y ≈1377 cm⁻¹ contienen la absorción del aceite mineral; no deben atribuirse sólo a la muestra.","Las asignaciones son propuestas basadas en la estructura conocida y en intervalos orientativos; no constituyen una identificación independiente del compuesto."],"distinctive":["Bandas diagnósticas: N–H (amida) 3363 cm⁻¹, N–H (amida) 3192 cm⁻¹.","El C=O aparece a menor número de onda que en cetonas (≈1690–1630 cm⁻¹); el número de bandas N–H distingue amidas primarias (dos), secundarias (una) y terciarias (ninguna)."],"howToRead":["Compruebe los ejes: número de onda (cm⁻¹) decreciente de izquierda a derecha y transmitancia en %; las absorciones son descensos de la curva.","Región de 4000 a 2500 cm⁻¹ (enlaces con H): N–H (amida) ≈3363 cm⁻¹; N–H (amida) ≈3192 cm⁻¹; C–H sp³ ≈2924 cm⁻¹. Fíjese en si hay bandas por encima de 3000 cm⁻¹ (C–H sp²/O–H/N–H) o sólo por debajo (C–H sp³).","Región de 2500 a 1500 cm⁻¹ (triples y dobles enlaces): C=O (amida I) ≈1653 cm⁻¹; N–H (flexión) ≈1653 cm⁻¹.","Región por debajo de 1500 cm⁻¹ (huella dactilar): C–H (flexión CH₂/CH₃) ≈1465 cm⁻¹; C–H (flexión CH₃ simétrica) ≈1378 cm⁻¹. Estas asignaciones son orientativas: en esta región se acoplan muchas vibraciones.","Conclusión para Propanamida: El C=O aparece a menor número de onda que en cetonas (≈1690–1630 cm⁻¹); el número de bandas N–H distingue amidas primarias (dos), secundarias (una) y terciarias (ninguna)."],"provenance":{"document":{"file":"ESPECTROS.docx","sha256":"1f4bf49fa4f5daada78481ea20921ee66da661441f44f81096d15a5dcfb78eec"},"docEntry":100,"docSection":"6 Amides","docName":"Propionamide","imageInDocx":"media/image57.png","imageSha256":"54702b4e6dc9899f8908217b80610cb5e30e7971d8591e250b8cb4b17011f1d7","imagePrintedName":"PROPIONAMIDE","techniquePrinted":"NUJOL MULL","nameCheck":"coincide","axisCalibration":{"frame":{"left":29,"right":714,"top":96,"bottom":417,"imageW":715,"imageH":553},"ticksFound":{"500":true,"1000":true,"1500":true,"2000":true,"3000":true},"model":"SDBS a tramos: 4000-2000 cm-1 y 2000-400 cm-1 (la segunda región con el doble de píxeles por cm-1); 100 %T arriba, 0 %T abajo"},"peakValidation":"pico OCR aceptado como verificado si existe un mínimo local de la curva digitalizada a ±2,5 px y ±5 %T","peakStats":{"verificado":16,"coherente":2,"dudoso":1},"detectedPeaksOnCurve":[{"x":3362.3,"y":17.3,"widthCm":295,"prominence":42.8},{"x":3180.1,"y":19.3,"widthCm":60,"prominence":6.1},{"x":2967.6,"y":13.7,"widthCm":6,"prominence":2.2},{"x":2914.5,"y":5.3,"widthCm":168,"prominence":85.7},{"x":2846.1,"y":14,"widthCm":14,"prominence":7.2},{"x":1652.6,"y":15.3,"widthCm":126,"prominence":45.2},{"x":1460.9,"y":13.4,"widthCm":223,"prominence":81.5},{"x":1417.2,"y":17.8,"widthCm":18,"prominence":11.1},{"x":1375.5,"y":21.8,"widthCm":8,"prominence":18.7},{"x":1292,"y":23.7,"widthCm":25,"prominence":29.9},{"x":1138.2,"y":33,"widthCm":22,"prominence":44.2},{"x":1066.1,"y":51.4,"widthCm":7,"prominence":30.8},{"x":1003.5,"y":74.5,"widthCm":10,"prominence":14.2},